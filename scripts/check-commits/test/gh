#!/usr/bin/env bash
set -euo pipefail
[[ "$1" == api ]]
endpoint=$2
shift 2
query='.'
while (($#)); do
  case "$1" in
    --jq) query=$2; shift 2 ;;
    -H) shift 2 ;;
    --paginate) shift ;;
    *) echo "Unexpected argument: $1" >&2; exit 1 ;;
  esac
done
printf '%s\n' "$endpoint" >> "$FIXTURE/calls"
case "$endpoint" in
  repos/test/repo/pulls/1/commits) source_file="$FIXTURE/commits.json" ;;
  repos/test/repo/pulls/1/files) source_file="$FIXTURE/pr-files.json" ;;
  repos/test/repo/commits/*) source_file="$FIXTURE/${endpoint##*/}.json" ;;
  repos/test/repo/contents/*) cat "$FIXTURE/content"; exit ;;
  *) echo "Unexpected endpoint: $endpoint" >&2; exit 1 ;;
esac
jq -r "$query" "$source_file"
